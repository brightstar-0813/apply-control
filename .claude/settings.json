{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "additionalDirectories": [
      "C:\\brightstar-bid-bot"
    ],
    "allow": [
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__select_page",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__wait_for",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__get_console_message",
      "mcp__chrome-devtools__list_network_requests",
      "mcp__chrome-devtools__get_network_request",
      "mcp__chrome-devtools__list_extensions",
      "Read(C:\\brightstar-bid-bot\\**)",
      "Bash(npm run check:*)",
      "Bash(npm test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"C:/apply-control/dashboard/hook.js\"", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node \"C:/apply-control/dashboard/hook.js\"", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node \"C:/apply-control/dashboard/hook.js\"", "timeout": 1800 } ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node \"C:/apply-control/dashboard/hook.js\"", "timeout": 10 } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "node \"C:/apply-control/dashboard/hook.js\"", "timeout": 10 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "node \"C:/apply-control/dashboard/hook.js\"", "timeout": 10 } ] }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:/apply-control/scripts/slack-stop-hook.ps1\"",
            "timeout": 30
          },
          { "type": "command", "command": "node \"C:/apply-control/dashboard/hook.js\"", "timeout": 15 }
        ]
      }
    ]
  }
}
